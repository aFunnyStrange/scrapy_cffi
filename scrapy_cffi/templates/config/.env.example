# Copy to .env. Process environment variables override this file.
# Nested model fields use a double underscore.
SCRAPY_CFFI_LOG_INFO__LOG_LEVEL=INFO
SCRAPY_CFFI_REDIS_INFO__URL=redis://127.0.0.1:6379/0
SCRAPY_CFFI_MYSQL_INFO__URL=mysql+asyncmy://root:123456@127.0.0.1:3306/scrapy_cffi
SCRAPY_CFFI_POSTGRES_INFO__URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/postgres
SCRAPY_CFFI_RABBITMQ_INFO__URL=amqp://guest:guest@127.0.0.1:5672/
SCRAPY_CFFI_KAFKA_INFO__URL=127.0.0.1:9092

# Arrays and dictionaries accept indented multiline JSON as well as one line.
# SCRAPY_CFFI_REDIS_INFO__SENTINELS=[["redis-1",26379],["redis-2",26379]]
