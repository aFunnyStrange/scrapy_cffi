# Copy to .env. Process environment variables override this file.
# Nested model fields use a double underscore.
LOG_INFO__LOG_LEVEL=INFO
REDIS_INFO__URL=redis://127.0.0.1:6379/0
MYSQL_INFO__URL=mysql+asyncmy://root:123456@127.0.0.1:3306/scrapy_cffi
POSTGRES_INFO__URL=postgresql+asyncpg://postgres:123456@127.0.0.1:5432/postgres
RABBITMQ_INFO__URL=amqp://guest:guest@127.0.0.1:5672/
KAFKA_INFO__URL=127.0.0.1:9092

# Optional runtime-only self-built curl_cffi wrapper directory. Leave unset to
# use the official installed curl_cffi implementation. This does not select a
# global impersonation profile.
# CURL_CFFI_RUNTIME_DIR=profiles/artifacts/windows-x86_64-py312

# Arrays and dictionaries accept indented multiline JSON as well as one line.
# REDIS_INFO__SENTINELS=[["redis-1",26379],["redis-2",26379]]
# Optional crawler monitoring Extension configuration (the Extension itself
# must also be registered explicitly in settings.py).
MONITOR_INFO__HUB_URL='http://127.0.0.1:6800'
# MONITOR_INFO__WORKER_ID='crawler-node-1'

# Optional EmailNotificationExtension configuration. Keep real credentials in
# the ignored .env file, never in this example.
# EMAIL_INFO__HOST='smtp.example.com'
# EMAIL_INFO__USERNAME='crawler@example.com'
# EMAIL_INFO__PASSWORD='replace-locally'
# EMAIL_INFO__TO_ADDRESSES='["ops@example.com"]'
